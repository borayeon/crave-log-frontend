# .env 파일

# ----------------------------------------------------
# 💡 상황에 따라 주석(#)을 풀고 묶으면서 API 대상을 스위칭하세요!
# ----------------------------------------------------

# [상황 A] 프론트엔드 UI만 수정할 때 -> 운영(홈 서버) 백엔드 연결
# VITE_API_BASE_URL=https://api.cravelog.me/api/v1

# [상황 B] 백엔드 코드도 같이 수정할 때 -> 로컬 백엔드(localhost:8080) 연결
VITE_API_BASE_URL=http://localhost:8080/api/v1